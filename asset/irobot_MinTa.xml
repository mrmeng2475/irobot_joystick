    <jointpos  joint="joint1_R"  name="joint1_R_pos"/>
    <jointpos  joint="joint2_R"  name="joint2_R_pos"/>
    <jointpos  joint="joint3_R"  name="joint3_R_pos"/>
    <jointpos  joint="joint4_R"  name="joint4_R_pos"/>
    <jointpos  joint="joint5_R"  name="joint5_R_pos"/>
    <jointpos  joint="joint6_R"  name="joint6_R_pos"/>
